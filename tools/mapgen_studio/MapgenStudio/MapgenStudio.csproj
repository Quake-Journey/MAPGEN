<Project Sdk="Microsoft.NET.Sdk">
  <!-- MAPGEN Studio: the portable desktop front end of MAPGEN-1 (doc/design/design_opus_2026-10-02_mapgen_studio.md,
       Fable's brief 3 section 2). .NET 10 + Avalonia 12 + FluentAvaloniaUI 3 - the current Fluent line; runs on
       Windows 10 and 11 alike (R15). -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MapgenStudio</AssemblyName>
    <RootNamespace>MapgenStudio</RootNamespace>
    <Version>2.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- Row 405: the PO, 2026-10-03 - «толпа DLL в папке студии ... выглядит как свинарник». A self-contained
         .NET app cannot keep its runtime in a subfolder (the host loads it from beside the exe), so the publish is
         ONE file: the runtime, Avalonia and the native libraries packed into MapgenStudio.exe, the natives
         unpacked by the host on first start. The folder holds the exe, its settings, data, engine and temp. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
  </ItemGroup>
  <!-- ... and SkiaSharp's native packages still lay their debug symbols beside it (100 MB nobody runs) -->
  <Target Name="DropNativeSymbols" AfterTargets="Publish">
    <ItemGroup>
      <NativeSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(NativeSymbols)" />
  </Target>
</Project>
